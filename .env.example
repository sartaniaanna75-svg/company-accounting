# Скопируйте в секреты App Platform / .env на сервере. Не коммитьте .env.
# В Docker / App Platform процесс слушает 0.0.0.0:80 (см. Dockerfile).

WT_BIND=127.0.0.1
WT_PORT=8780

# Локальный тестовый режим (только на своём ПК, НЕ на Timeweb):
# WT_LOCAL_TEST=1
# Тогда обязателен DATABASE_URL вида:
#   postgresql://worktime_tester:***@127.0.0.1:5433/worktime_test
# PGHOST/PGUSER/… при WT_LOCAL_TEST=1 запрещены.
# Удобный запуск: server/run_local_test.ps1 (сам включает WT_LOCAL_TEST=1).

# Секреты только в панели / .env, не в git.
# WT_PIN_PEPPER=
# WT_SESSION_HOURS=12
# На Timeweb HTTPS обязательно: WT_COOKIE_SECURE=1
# WT_COOKIE_SECURE=1
# Общий WT_API_TOKEN сотрудникам не выдавать и для входа не использовать.

# Первый администратор только командой: python wt_api.py bootstrap
# Значения задавать в панели Timeweb / .env, не в git.
# WT_BOOTSTRAP_NAME=
# WT_BOOTSTRAP_PIN=
# WT_BOOTSTRAP_USER_ID=user_admin

# Вариант 1: одна строка
DATABASE_URL=postgresql://worktime:CHANGE_ME@127.0.0.1:5432/worktime

# Только для локальных интеграционных тестов ops (НЕ рабочая БД Timeweb).
# Обязательно: хост 127.0.0.1|localhost и имя базы worktime_test — иначе тесты откажутся выполнять SQL.
# WT_TEST_DATABASE_URL=postgresql://worktime_test:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/worktime_test

# Вариант 2: отдельные переменные (если DATABASE_URL пуст)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=worktime
# PGUSER=worktime
# PGPASSWORD=CHANGE_ME
